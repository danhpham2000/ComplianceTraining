{
  "name": "compliance-training",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload",
    "seed:api": "cd apps/api && uv run python -m app.seed",
    "test:api": "cd apps/api && uv run pytest"
  }
}

